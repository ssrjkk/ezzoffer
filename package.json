    "lint": "eslint",
    "test": "node --experimental-test-module-mocks --import tsx --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "seed": "node scripts/seed.js",
    "bot:poll": "node scripts/bot-poll.mjs",
    "bot:menu": "node scripts/set-bot-menu.mjs",
