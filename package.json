    "package:deploy": "node scripts/package-deploy.mjs",
    "export:pages": "node scripts/export-pages.mjs",
    "catalog:snapshot": "node --import tsx scripts/snapshot-fixtures.mts"
  },
  "overrides": {
    "source-map-js": "1.2.2",
