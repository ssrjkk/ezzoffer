# ============================================================
# EZOffer — пример конфигурации. Скопируйте в .env и заполните.
# ============================================================

# Публичный домен для sitemap/robots/метаданных.
SITE_URL=http://localhost:3000

# Порт для `next start` (и Docker).
PORT=3000

# ------------------------------------------------------------
# hh.ru — РЕАЛЬНЫЕ отклики на вакансии (OAuth)
# ------------------------------------------------------------
# Создайте приложение на https://dev.hh.ru (раздел «Мои приложения»):
#   Redirect URI: ваш SITE_URL + /api/hh/callback
# Включите права: "Отклики" (negotiations), "Чтение откликов",
# "Чтение вакансий", "Резюме".
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=

# Глобальный токен hh.ru. Нужен ТОЛЬКО для поиска вакансий (GET /vacancies
# отвечает 403 без токена). Обычно не нужен: сервис сам получает токен
# приложения по client_credentials из HH_CLIENT_ID + HH_CLIENT_SECRET и
# кэширует его. Оставьте пустым, если приложение на dev.hh.ru создано.
#
# ВАЖНО: этот токен НЕ используется для отправки откликов. Отклик уходит
# с токена самого пользователя (users.hh_token) — иначе он ушёл бы не от
# того, кому принадлежит.
HH_ACCESS_TOKEN=

# ------------------------------------------------------------
# Каталог вакансий
# ------------------------------------------------------------
# Обновление идёт под активные поиски пользователей: тексты запросов
# берутся из searches, а не берётся общая витрина площадки.
#
# Быстрые источники (hh.ru) обновляем часто — на них держится обещание
# «отклик в первые минуты после публикации». При шестичасовом интервале
# вакансия, опубликованная два часа назад, попадала бы в автоотклик через
# шесть, и обещание было бы невыполнимо по построению.
CATALOG_FAST_TTL_MS=1800000
# Медленные агрегаторы обновляем реже, чтобы не бить по их лимитам.
CATALOG_SLOW_TTL_MS=21600000
# Застой каталога: если при живых поисках обновления не было дольше этого
# срока — владельцу (ADMIN_TELEGRAM_CHAT_ID) уходит предупреждение.
# Минимум — час, по умолчанию — 12 часов (два пропущенных медленных цикла).
CATALOG_STALL_WARN_MS=43200000

# ------------------------------------------------------------
# Автоотклики: мягкие лимиты (защита от блокировок)
# ------------------------------------------------------------
AUTOAPPLY_DAILY_CAP=0
AUTOAPPLY_HOURLY_CAP=12
AUTOAPPLY_MIN_INTERVAL_SEC=45
AUTOAPPLY_MAX_INTERVAL_SEC=180
# Человеческий профиль отправок (анти-детект). Ровный машинный поток —
# главная примета автооткликов: случайные 45с–3мин без единого перерыва,
# полные лимиты в первый же день и одинаковые объёмы в выходные.
#  - LONG_BREAK_CHANCE (0–1): вероятность длинного перерыва 15–45 минут
#    после отправки. Ломает равномерное заполнение каждого часа.
#  - WEEKEND_FACTOR (0–1): множитель суточного лимита в сб/вс. 1 — выключено.
#  - WARMUP_DAYS: линейный прогрев нового отправителя от 1/N объёма в день
#    первой отправки до полного. 0 — выключено.
# Значения ниже — рекомендованный профиль для продакшена.
AUTOAPPLY_LONG_BREAK_CHANCE=0.12
AUTOAPPLY_LONG_BREAK_MIN_SEC=900
AUTOAPPLY_LONG_BREAK_MAX_SEC=2700
AUTOAPPLY_WEEKEND_FACTOR=0.5
AUTOAPPLY_WARMUP_DAYS=7
AUTOAPPLY_WORK_START=9
AUTOAPPLY_WORK_END=20
# Рубильники отправки. ENABLED=0 — полная остановка (планировщик и ручные
# запуски отвечают «выключено»). DRY_RUN=1 — холостой прогон без POST в hh
# (подбор считается, история не пишется). Для стейджинга с живыми данными.
#AUTOAPPLY_ENABLED=1
#AUTOAPPLY_DRY_RUN=

# Секрет для вызова /api/autoapply/run из внешнего cron.
CRON_SECRET=

# ------------------------------------------------------------
# Telegram-бот (необязательно)
# ------------------------------------------------------------
# Токен бота от @BotFather. Без него бот не отправляет сообщения.
TELEGRAM_BOT_TOKEN=
# Секрет, который BotFather/setWebhook шлёт в заголовке
# X-Telegram-Bot-Api-Secret-Token. Обязателен: без него вебхук не работает.
TELEGRAM_WEBHOOK_SECRET=
# URL для регистрации вебхука: https://<домен>/api/telegram/webhook
# Регистрируется вручную: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<SECRET>
# Куда слать уведомления владельцу: заявки на консультации, застой каталога.
# Это chat id человека, а не @username бота. Без него заявки только копятся,
# а застой виден лишь в логах.
#ADMIN_TELEGRAM_CHAT_ID=
# Быстрый разбор входящих (1 — отвечать за секунды после 200,
# 0 — только тиком планировщика). На бессерверном хостинге ставьте 0:
# там после ответа процесс умирает и фоновая работа обрывается.
TELEGRAM_FAST_PATH=1

# ------------------------------------------------------------
# Письма (восстановление пароля)
# ------------------------------------------------------------
# Без SMTP_* восстановление пароля не работает: письмо просто не уходит.
# Любой SMTP с поддержкой STARTTLS подойдёт (Mailgun, Yandex, Gmail App Password).
# Порт 465 — implicit TLS, 587 — STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Отправитель в письмах. Если пусто — берётся SMTP_USER.
SMTP_FROM=

# ------------------------------------------------------------
# AI-улучшение резюме и персонализация писем (необязательно)
# ------------------------------------------------------------
# OpenAI-совместимый ключ. Без него используются локальные эвристики.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ------------------------------------------------------------
# Каталог вакансий (источники без ключей)
# ------------------------------------------------------------
# RSS-фиды вакансий компаний (через запятую).
COMPANY_JOB_FEEDS=
# Доски Greenhouse (через запятую, путь = стандартные).
GREENHOUSE_BOARDS=

# ------------------------------------------------------------
# Прочее
# ------------------------------------------------------------
SCHEDULER_INTERVAL_MS=300000
EZOFFER_DB_PATH=
# За прокси (Caddy/Nginx) ставьте 1: иначе rate-limit и логи видят IP самого
# прокси вместо клиента. 0 — только для прямого запуска без прокси.
TRUST_PROXY=0
EZOFFER_SILENT=0

# ------------------------------------------------------------
# Тарифы без оплаты (только для локальной разработки и демо)
# ------------------------------------------------------------
# DEMO_MODE_PLAN=1 разрешает бесплатную активацию тарифов через /api/plan.
# В проде НЕ включайте: любой зарегистрированный получал бы платные тарифы.
# Прод-выдача прав идёт только через подписанные вебхуки оплаты (grant()).
#DEMO_MODE_PLAN=

# Шифрование токенов hh.ru в БД (AES-256-GCM, ровно 32 байта, hex или base64).
# Без него токены лежат открытым текстом — и в бэкапах тоже. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#EZOFFER_TOKEN_KEY=

# Подпись вебхуков оплаты (HMAC-SHA256 по телу). Без него вебхуки отвечают
# 503, тарифы не выдаются.
#PAYMENT_HMAC_SECRET=
# Адрес кошелька для приёма крипты (USDT). Без него способ crypto_usdt
# показывает «не настроен».
#PAYMENT_CRYPTO_USDT_WALLET=

# Секрет подписи ответов внешнего входа (Telegram/GitHub/...).
# Без него внешний вход закрыт (401), а не «работает без проверки».
#OAUTH_STATE_SECRET=
