# ============================================================
# EZOffer — пример конфигурации. Скопируйте в .env и заполните.
# ============================================================

# Публичный домен для sitemap/robots/метаданных.
SITE_URL=http://localhost:3000

# Порт для `next start` (и Docker).
PORT=3000

# ------------------------------------------------------------
# hh.ru — РЕАЛЬНЫЕ отклики на вакансии
# ------------------------------------------------------------
# Чтобы отправлять настоящие отклики через API hh.ru, нужно приложение
# на https://dev.hh.ru (раздел «Мои приложения»):
#   Redirect URI: ваш SITE_URL + /api/hh/callback  (например http://localhost:3000/api/hh/callback)
# Включите в приложении права: "Отклики" (negotiations) и "Чтение откликов",
# "Чтение вакансий", "Резюме".
# OAuth-ключи (для подключения ЛИЧНОГО аккаунта hh.ru через кнопку «Подключить аккаунт hh.ru»):
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=

# Либо глобальный токен доступа hh.ru (если не используете OAuth-флоу).
# Без него вакансии hh.ru не подгружаются и отклики не отправляются.
HH_ACCESS_TOKEN=

# ------------------------------------------------------------
# Автоотклики: мягкие лимиты (защита от блокировок платформ)
# ------------------------------------------------------------
# Глобальный потолок откликов в сутки на пользователя (0 = без потолка).
AUTOAPPLY_DAILY_CAP=0
# Потолок откликов в час на пользователя.
AUTOAPPLY_HOURLY_CAP=12
# Пауза между откликами, секунды (мин/макс — рандомизация).
AUTOAPPLY_MIN_INTERVAL_SEC=45
AUTOAPPLY_MAX_INTERVAL_SEC=180
# Часы работы автооткликов (локальное время, 0-23).
AUTOAPPLY_WORK_START=9
AUTOAPPLY_WORK_END=20

# Секрет для вызова /api/autoapply/run из внешнего cron-воркера.
CRON_SECRET=

# ------------------------------------------------------------
# Каталог вакансий (дополнительные источники)
# ------------------------------------------------------------
# RSS-фиды вакансий компаний (через запятую).
COMPANY_JOB_FEEDS=
# Список досок Greenhouse для парсинга (через запятую, пусто = стандартные).
GREENHOUSE_BOARDS=
# Bearer-токен X / Twitter API v2 для поиска вакансий.
X_API_BEARER_TOKEN=
# Telegram-каналы компаний (для источника «Каналы компаний»).
# Бот-токен И каналы (user_id или @channel через запятую).
TELEGRAM_SOURCE_BOT_TOKEN=
TELEGRAM_SOURCE_CHANNELS=
# Работа.ру — работает без ключей (парсинг JSON-LD). Источник «Работа.ру».
# Автоотклик не поддерживается: кнопка «На сайте» ведёт на вакансию.

# ------------------------------------------------------------
# ИИ (улучшение резюме, персонализация писем)
# ------------------------------------------------------------
# OpenAI-совместимый API (можно любой провайдер).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Telegram-бот (уведомления + управление автооткликами)
# ------------------------------------------------------------
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Имя бота (например EZOfferBot) для команды /start.
TELEGRAM_BOT_USERNAME=
# Секрет для вебхука /api/telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Email: уведомления (дневные отчёты) + рассылка резюме на email компаний
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EZOffer <no-reply@example.com>

# ------------------------------------------------------------
# Прочее
# ------------------------------------------------------------
# Запускать ли планировщик внутри процесса (мс, min 60000).
SCHEDULER_INTERVAL_MS=300000
# TTL обновления каталога в планировщике (мс).
CATALOG_TTL_MS=21600000
# Путь к файлу SQLite (по умолчанию ./data/ezoffer.db).
EZOFFER_DB_PATH=
# "1", если приложение за reverse-proxy (доверять X-Forwarded-For).
TRUST_PROXY=0
# "1" — выключить логирование в stdout.
EZOFFER_SILENT=0